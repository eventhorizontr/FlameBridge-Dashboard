# Copy to .env.local (gitignored). Set the same keys in Vercel project settings.
# The assistant offers every provider whose key is set (ADR-015).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default provider when the user has not chosen one: openai | claude
AI_DEFAULT_PROVIDER=openai
# Model overrides (optional)
OPENAI_MODEL=gpt-6.1-sol
CLAUDE_MODEL=claude-opus-5-5

# --- AI usage limit (ADR-028) ---------------------------------------------------------------
# Each visitor IP may send at most AI_QUOTA_LIMIT questions to the assistant.
AI_QUOTA_LIMIT=10
# 0 = a total that never resets; e.g. 24 = per day.
AI_QUOTA_WINDOW_HOURS=0
# Random string used to hash IPs before they are stored (set your own on Vercel).
AI_QUOTA_SALT=
# Shared counter (required on Vercel so all instances count together): add Upstash Redis from the
# Vercel Marketplace (Storage tab); it injects these two variables automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
