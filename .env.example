# Copy to .env.local (gitignored). Set the same keys in Vercel project settings.
# The assistant offers every provider whose key is set (ADR-012).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default provider when the user has not chosen one: claude | gemini
AI_DEFAULT_PROVIDER=claude
# Model overrides (optional)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=
